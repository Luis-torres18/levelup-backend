# Copia este archivo como ".env" (en la misma carpeta que docker-compose.yml) y cambia los valores.
# Docker Compose lo lee automáticamente.

# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=root

# Clave para firmar los tokens JWT (la misma para los 3 microservicios). Mínimo 32 caracteres.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta-de-al-menos-32-caracteres

# Orígenes que pueden llamar a la API (separados por coma, sin espacios).
# Pon aquí la URL de tu bucket S3 y la del frontend local:
# CORS_ORIGINS=http://mi-bucket.s3-website-us-east-1.amazonaws.com,http://localhost:5173
CORS_ORIGINS=*
